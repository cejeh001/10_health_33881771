<!DOCTYPE html>
<html>
<head>
    <title>All Foods - Food Macro Tracker</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('partials/header') %>

    <main>
        <h1>All Foods</h1>

        <!-- Success/Error Messages -->
        <% if (success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <!-- Add Food Button -->
        <% if (user) { %>
            <a href="/foods/add" class="btn btn-primary">+ Add Food</a>
        <% } %>

        <!-- Search Bar -->
        <form action="/foods/search" method="GET" class="search-form">
            <input type="text" name="q" placeholder="Search foods..." required>
            <button type="submit">Search</button>
        </form>

        <!-- Food List -->
        <% if (foods && foods.length > 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Calories</th>
                        <th>Protein (g)</th>
                        <th>Carbs (g)</th>
                        <th>Fats (g)</th>
                        <% if (user) { %>
                            <th>Actions</th>
                        <% } %>
                    </tr>
                </thead>
                <tbody>
                    <% foods.forEach(food => { %>
                        <tr>
                            <td><%= food.name %></td>
                            <td><%= food.calories %></td>
                            <td><%= food.protein %></td>
                            <td><%= food.carbs %></td>
                            <td><%= food.fats %></td>
                            <% if (user) { %>
                                <td>
                                    <a href="/foods/edit/<%= food.id %>" class="btn-edit">Edit</a>
                                    <form action="/foods/delete/<%= food.id %>" method="POST" style="display: inline;">
                                        <button type="submit" class="btn-delete" onclick="return confirm('Delete <%= food.name %>?')">Delete</button>
                                    </form>
                                </td>
                            <% } %>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } else { %>
            <p>
                No foods found. 
                <% if (user) { %>
                    <a href="/foods/add">Add your first food!</a>
                <% } else { %>
                    Please <a href="/auth/login">login</a> to add foods.
                <% } %>
            </p>
        <% } %>
    </main>

    <%- include('partials/footer') %>
</body>
</html>