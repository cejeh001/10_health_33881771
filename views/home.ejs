<%- include('partials/header') %>
<section>
  <h2>Welcome</h2>
  <p>Track macros for foods, add your own entries, and search the database.</p>
  <ul>
    <li><a href="/foods">View all foods</a></li>
    <li><a href="/foods/search">Search foods</a></li>
    <li><a href="/foods/add">Add a food (login required)</a></li>
  </ul>
</section>

<section>
  <h2>Featured Foods</h2>
  <div class="featured-foods">
    <% featuredFoods.forEach(food=> { %>
      <div class="food-card">
        <h3>
          <%= food.name %>
        </h3>
        <p>Calories: <%= food.calories %>
        </p>
        <p>Protein: <%= food.protein %>g</p>
        <p>Carbs: <%= food.carbs %>g</p>
        <p>Fats: <%= food.fats %>g</p>
      </div>
      <% }) %>
  </div>
</section>

<%- include('partials/footer') %>