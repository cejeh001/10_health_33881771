<!DOCTYPE html>
<html>
<head>
    <title><%= food ? 'Edit Food' : 'Add Food' %> - Food Macro Tracker</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('partials/header') %>
    
    <main>
        <h1><%= food ? 'Edit Food' : 'Add New Food' %></h1>
        
        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>
        
        <form action="<%= food ? '/foods/edit/' + food.id : '/foods/add' %>" method="POST">
            <div class="form-group">
                <label for="name">Food Name *</label>
                <input type="text" id="name" name="name" value="<%= food ? food.name : '' %>" required>
            </div>
            
            <div class="form-group">
                <label for="calories">Calories *</label>
                <input type="number" id="calories" name="calories" value="<%= food ? food.calories : '' %>" min="0" required>
            </div>
            
            <div class="form-group">
                <label for="protein">Protein (g)</label>
                <input type="number" id="protein" name="protein" value="<%= food ? food.protein : '0' %>" step="0.1" min="0">
            </div>
            
            <div class="form-group">
                <label for="carbs">Carbs (g)</label>
                <input type="number" id="carbs" name="carbs" value="<%= food ? food.carbs : '0' %>" step="0.1" min="0">
            </div>
            
            <div class="form-group">
                <label for="fats">Fats (g)</label>
                <input type="number" id="fats" name="fats" value="<%= food ? food.fats : '0' %>" step="0.1" min="0">
            </div>
            
            <button type="submit"><%= food ? 'Update Food' : 'Add Food' %></button>
            <a href="/foods" class="btn-cancel">Cancel</a>
        </form>
    </main>
    
    <%- include('partials/footer') %>
</body>
</html>